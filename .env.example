# Required for Claude-powered coaching. Without it the app falls back to
# heuristic (template) coaching — still playable, noticeably less good.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-5.
#
# Measured on identical requests with the engine idle: claude-sonnet-5 answers
# in 3.3-3.7s, claude-opus-5 in 5.1-6.7s, claude-haiku-4-5 in 2.6-3.1s. A note
# is two or three sentences written from candidates and facts the engine has
# already worked out, so the wait matters more here than the extra reasoning.
#
# Changing this changes the cache key, so a switch does not serve the previous
# model's notes back to you.
COACH_MODEL=claude-sonnet-5

# Optional. Shared cache of coaching notes, read by every visitor and durable
# across deploys — one player pays for a position, everyone after them reads it
# back. Without these there is no cache and every note is written fresh.
#
# Create a project at supabase.com, run supabase/migrations/0001_coach_cache.sql
# against it, then take both values from Project Settings -> API Keys. Use the
# secret key (sb_secret_...), not the publishable one: it bypasses row-level
# security, so it is server-side only and never belongs in client code.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
