# Required for Claude-powered coaching. Without it the app falls back to
# heuristic (template) coaching — still playable, noticeably less good.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# claude-sonnet-5 or claude-haiku-4-5 are cheaper/faster if you'd rather trade
# a little coaching quality for latency and cost.
COACH_MODEL=claude-opus-5
